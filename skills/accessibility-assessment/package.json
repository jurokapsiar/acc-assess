{
  "name": "accessibility-assessment-skill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Playwright + axe-core + AbleDOM accessibility assessment tooling for the accessibility-assessment skill.",
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "knowledge": "node scripts/fetch-knowledge.mjs",
    "inventory": "node scripts/inventory.mjs",
    "assess": "node scripts/assess.mjs",
    "report": "node scripts/report.mjs",
    "fixes": "node scripts/fixes.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@jridgewell/trace-mapping": "^0.3.31",
    "abledom": "^0.7.1",
    "cheerio": "^1.1.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
